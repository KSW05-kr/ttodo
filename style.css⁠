* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

body {
  background-color: #000000;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  display: flex;
  justify-content: center;
  min-height: 100vh;
}

#app {
  width: 100%;
  max-width: 430px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.news-card {
  background-color: #121212;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid #262626;
}
.news-label {
  font-size: 12px;
  color: #8e8e93;
  margin-bottom: 4px;
}
.news-text {
  font-size: 14px;
  color: #f2f2f7;
  line-height: 1.3;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.calendar-header h2 {
  font-size: 18px;
  font-weight: 600;
}
.calendar-header button {
  background: none;
  border: none;
  color: #0a84ff;
  font-size: 20px;
  padding: 4px 12px;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 12px;
  color: #8e8e93;
  margin-bottom: 8px;
}
.weekdays .sun { color: #ff453a; }
.weekdays .sat { color: #0a84ff; }

.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 6px;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #1c1c1e;
  border-radius: 10px;
  font-size: 14px;
  cursor: pointer;
}

.day-cell.today {
  background-color: #0a84ff !important;
  color: #ffffff;
  font-weight: bold;
  border-radius: 50%;
}

.badge-area {
  font-size: 9px;
  height: 10px;
  margin-top: 2px;
}
.red-triangle { color: #ff453a; }
.green-circle { color: #30d158; }

.todo-card {
  background-color: #1c1c1e;
  padding: 16px;
  border-radius: 14px;
}
.todo-card h3 {
  font-size: 15px;
  margin-bottom: 12px;
  color: #0a84ff;
}
.todo-input-box {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}
.todo-input-box input {
  flex: 1;
  background-color: #2c2c2e;
  border: none;
  border-radius: 8px;
  padding: 10px;
  color: #ffffff;
}
.todo-input-box button {
  background-color: #0a84ff;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 0 16px;
  font-weight: 600;
}
.todo-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #2c2c2e;
  padding: 10px;
  border-radius: 8px;
  font-size: 14px;
}
.todo-item.completed span {
  text-decoration: line-through;
  color: #8e8e93;
}
